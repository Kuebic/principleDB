{
  "name": "principledb",
  "private": true,
  "type": "module",
  "description": "Self-hostable MCP server that turns a body of teaching into atomic principles backed by verbatim, located quotes.",
  "bin": {
    "principledb-mcp": "bin/principledb-mcp.ts"
  },
  "scripts": {
    "prototype": "tsx prototype/spine.ts",
    "ingest": "tsx prototype/ingest-spike.ts",
    "sandcastle": "npx tsx .sandcastle/main.ts",
    "mcp": "tsx bin/principledb-mcp.ts",
    "serve": "tsx bin/principledb-serve.ts",
    "ingest:text": "tsx bin/principledb-ingest.ts",
    "ingest:html": "tsx bin/principledb-ingest-html.ts",
    "ingest:dir": "tsx bin/principledb-ingest-dir.ts",
    "ingest:pdf": "tsx bin/principledb-ingest-pdf.ts",
    "ingest:dunkley": "tsx scripts/ingest-dunkley.ts",
    "backfill:works": "tsx scripts/backfill-works.ts",
    "backfill:editions": "tsx scripts/backfill-editions.ts",
    "doctor": "tsx bin/principledb-doctor.ts",
    "db:migrate": "tsx bin/principledb-migrate.ts",
    "db:recover-editions": "tsx scripts/recover-editions-migration.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.10.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@hono/node-server": "^1.19.14",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.30",
    "node-html-parser": "^8.0.4",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
