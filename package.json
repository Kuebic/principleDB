{
  "name": "principledb-prototype",
  "private": true,
  "type": "module",
  "description": "THROWAWAY core-spine prototype for principleDB (see prototype/). Safe to delete once the question is answered.",
  "bin": {
    "principledb-mcp": "bin/principledb-mcp.ts"
  },
  "scripts": {
    "prototype": "tsx prototype/spine.ts",
    "ingest": "tsx prototype/ingest-spike.ts",
    "sandcastle": "npx tsx .sandcastle/main.ts",
    "mcp": "tsx bin/principledb-mcp.ts",
    "ingest:text": "tsx bin/principledb-ingest.ts",
    "doctor": "tsx bin/principledb-doctor.ts",
    "db:migrate": "tsx bin/principledb-migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.10.0",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
