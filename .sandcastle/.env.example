# --- Sandcastle orchestration (the autonomous build loop) ---
# Claude Code OAuth token — get one by running `claude setup-token` on your host.
# Lets the agent use your Claude subscription instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# Or use an Anthropic API key instead — uncomment and fill in:
# ANTHROPIC_API_KEY=
# GitHub personal access token — the agent uses it to read and manage GitHub Issues
# Create a fine-grained token: https://github.com/settings/personal-access-tokens/new
# Required repository permissions: Issues (Read and write) and Metadata (Read)
GH_TOKEN=

# --- principleDB MCP server (the running instance) ---
# See docs/SELF_HOSTING.md for the full provisioning runbook.

# Postgres + pgvector. Supabase: Settings → Database → Connection string → URI.
# Use the pooler URL (port 6543) for app connections; the direct URL is only
# needed when applying migrations or running schema-isolating tests.
DATABASE_URL=postgres://postgres:PASSWORD@HOST:6543/postgres?sslmode=require

# Distil — Anthropic (ADR-0008). Default claude-opus-4-8; override with
# PRINCIPLEDB_DISTIL_MODEL to pin a different Claude model.
ANTHROPIC_API_KEY=sk-ant-...
# PRINCIPLEDB_DISTIL_MODEL=claude-opus-4-8

# Embed — OpenAI (ADR-0011). Default text-embedding-3-small at 1536 dim,
# matching the schema's EMBEDDING_DIM pinning. Changing the model requires a
# schema migration; don't override casually.
OPENAI_API_KEY=sk-...
# PRINCIPLEDB_EMBED_MODEL=text-embedding-3-small

# R2 blob lake — slice 3 onward (ADR-0010). Cloudflare → R2 → bucket → Settings
# → S3 API → Manage API tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=principledb
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
